# Copy to .env and fill in RIOT_API_KEY. Never commit .env.

# Riot API key (required for crawling); sent only in the X-Riot-Token header
RIOT_API_KEY=
# Platform routing values to crawl, comma-separated
REGIONS=eun1,na1,kr
# Queue to collect (420 = Ranked Solo/Duo)
QUEUE_ID=420
# Only matches started within the last N days
WINDOW_DAYS=14
# ISO date (YYYY-MM-DD) of the last ranked reset; warn if the window starts before it
SPLIT_RESET_DATE=
# Fetch the /timeline of every match (true/false)
FETCH_TIMELINES=true
# K: match IDs taken per seed player per visit
MATCHES_PER_PLAYER=5
# Crawl strategy: stratified or snowball
STRATEGY=stratified
# GameName#TAG start point, required only for STRATEGY=snowball
SEED_RIOT_ID=
# Reuse a player's rank lookup made within this many hours
RANK_REUSE_HOURS=6
# Use at most this fraction (0-1] of every rate limit window
RATE_LIMIT_SAFETY=0.9
# Seconds between .env re-reads while the key is invalid
KEY_POLL_SECONDS=30
# Attempts for 5xx / network errors before an item is parked
MAX_RETRIES=5
# Seconds of all requests failing before switching to offline mode
OFFLINE_AFTER_SECONDS=300
# Pause crawling when free disk space drops below this many GB
MIN_FREE_DISK_GB=2
# Roll raw part files at roughly this compressed size in MB
RAW_ROLL_MB=128
# Root folder for raw data, exports and state
DATA_DIR=data
# Folder for rotating log files
LOG_DIR=logs
